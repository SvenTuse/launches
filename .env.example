ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
# local = edit original folders; blob = persistent private storage on Vercel
STORAGE_DRIVER=local
# On Vercel, connect a Private Blob store; OIDC credentials are provided automatically.
# For Blob access outside Vercel, supply a read/write token here.
BLOB_READ_WRITE_TOKEN=
